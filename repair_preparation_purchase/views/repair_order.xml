<odoo>

    <record id="repair_preparation" model="ir.ui.view">
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair_preparation.repair_order_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//button[@name='action_view_preparation_picking']"
                position="after"
            >
                <button
                    name="action_view_preparation_purchase_order"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-credit-card"
                    attrs="{'invisible': [('repair_preparation_enabled', '=', False)]}"
                    groups="purchase.group_purchase_user"
                >
                    Preparation Purchase(s)
                </button>
            </xpath>
        </field>
    </record>



</odoo>
