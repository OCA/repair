<odoo>

    <record id="stock_warehouse_form_view" model="ir.ui.view">
        <field name="model">stock.warehouse</field>
    <field name="inherit_id" ref="stock.view_warehouse" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='technical_info']" position="inside">
            <group string="Repairs — Preparation">
                <group>
              <field name="repair_preparation_enabled" />

                </group>
                <group>
                    <field
                            name="repair_preparation_picking_type_id"
                            attrs="{'invisible': [('repair_preparation_enabled','=', False)]}"
                        />
                </group>
            </group>
      </xpath>
        </field>
    </record>



</odoo>
