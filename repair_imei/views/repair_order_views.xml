<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Form View Extension -->
    <record id="view_repair_order_form_inherit_imei" model="ir.ui.view">
        <field name="name">repair.order.form.inherit.imei</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="imei_required" invisible="1" />
                <field
                    name="imei_no"
                    placeholder="e.g. 356938035643809"
                    required="imei_required"
                />
            </xpath>
        </field>
    </record>

    <!-- Search View Extension (Fixed External ID) -->
    <record id="view_repair_order_search_inherit_imei" model="ir.ui.view">
        <field name="name">repair.order.search.inherit.imei</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="imei_no" string="IMEI No" />
            </xpath>
        </field>
    </record>
</odoo>
