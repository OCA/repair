<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Repair Order Form View Extension -->
    <record id="view_repair_order_form_inherit_manufacturer" model="ir.ui.view">
        <field name="name">repair.order.form.inherit.manufacturer</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_manufacturer', '=', False)]</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field
                    name="manufacturer_id"
                    context="{'default_is_manufacturer': True, 'default_is_company': True}"
                />
            </xpath>
        </field>
    </record>

    <!-- Repair Order Search View Extension -->
    <record id="view_repair_order_search_inherit_manufacturer" model="ir.ui.view">
        <field name="name">repair.order.search.inherit.manufacturer</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form_filter" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="manufacturer_id" string="Manufacturer" />
            </xpath>
            <xpath expr="//group" position="inside">
                <filter
                    string="Manufacturer"
                    name="groupby_manufacturer"
                    context="{'group_by': 'manufacturer_id'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
