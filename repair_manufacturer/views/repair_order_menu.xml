<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Dedicated List View for Manufacturers -->
    <record id="view_partner_manufacturer_tree" model="ir.ui.view">
        <field name="name">res.partner.manufacturer.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Manufacturers" sample="1">
                <field name="image_128" widget="image" string="Logo" />
                <field name="display_name" string="Manufacturer Name" />
                <field name="ref" string="Code" />
            </list>
        </field>
    </record>

    <!-- Dedicated Action for Manufacturers -->
    <record id="action_repair_manufacturer_partner" model="ir.actions.act_window">
        <field name="name">Manufacturers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_manufacturer', '=', True)]</field>
        <field name="context">{
            'default_is_manufacturer': True,
            'default_is_company': True
        }</field>
        <!-- Explicit View Ordering -->
        <field
            name="view_ids"
            eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_partner_manufacturer_tree')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'form'})
        ]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Product Manufacturer
            </p>
        </field>
    </record>

    <!-- Menu Item in Repair Configuration -->
    <menuitem
        id="menu_repair_manufacturer"
        name="Manufacturers"
        parent="repair.repair_menu_config"
        action="action_repair_manufacturer_partner"
        sequence="10"
    />
</odoo>
