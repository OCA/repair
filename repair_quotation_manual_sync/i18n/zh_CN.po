#. module: repair_quotation_manual_sync
#: model_terms:ir.ui.view,arch_db:repair_quotation_manual_sync.view_order_form_repair_sync_banner
msgid ""
"<i class=\"fa fa-info-circle\"/>\n"
"                        <span class=\"oe_inline\">\n"
"                            Repair Order and Quotation are not synchronized.\n"
"                            Would you like to synchronize this Sale Order with the repair lines?\n"
"                        </span>"
msgstr ""
"<i class=\"fa fa-info-circle\"/>\n"
"                        <span class=\"oe_inline\">\n"
"                            维修订单和报价单未同步。\n"
"                            您是否要将此销售订单与维修行同步？\n"
"                        </span>"

#. module: repair_quotation_manual_sync
#: model:ir.model.fields,help:repair_quotation_manual_sync.field_stock_move__repair_invoiceable
msgid ""
"Check this box if the product is billable. Only invoiceable products will be"
" included in the quotation."
msgstr ""
"如果产品是可计费的，请勾选此框。只有可计费的产品才会包含在报价单中。"

