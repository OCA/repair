<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_search" model="ir.ui.view">
        <field name="name">stock.move.search.repair</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_move_search" />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="/search" position="inside">
                <separator />
                <filter
                    name="filter_consumptions"
                    string="Consumptions"
                    domain="[('repair_line_type','!=',False)]"
                    help="Only show consumption moves linked to repair lines"
                />
                <filter
                    name="filter_repaired"
                    string="Repaired Products"
                    domain="[('repair_line_type','=',False)]"
                    help="Only show repaired product moves linked to repair lines"
                />
            </xpath>
        </field>
    </record>

    <record id="action_repair_stock_moves" model="ir.actions.act_window">
        <field name="name">Repair Stock Moves</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="stock.view_move_tree" />
        <field name="search_view_id" ref="view_move_search" />
        <field name="domain">[('repair_id','!=',False)]</field>
    </record>

    <menuitem
        id="menu_repair_stock_moves"
        name="Repair Stock Moves"
        parent="stock.menu_warehouse_report"
        action="action_repair_stock_moves"
        sequence="310"
    />
</odoo>
