<odoo>

    <record model="ir.ui.view" id="repair_order_form_view">
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='extra_info']//group/field[@name='invoiced']"
                position="after"
            >
                <field name="quotation_sent" />
            </xpath>

            <xpath
                expr="//button[@name='action_repair_cancel_draft']"
                position="before"
            >
                <button
                    name="action_validate"
                    states="sent"
                    type="object"
                    string="Confirm Repair"
                    class="oe_highlight"
                    data-hotkey="v"
                />
            </xpath>

        </field>
    </record>

</odoo>
