<odoo>

    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="base_repair_config.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='repair_setting_container']" position="inside">
                <div
                    class="col-12 col-lg-6 o_setting_box"
                    title="Repair Email Configuration"
                >
                    <div class="o_setting_left_pane">
                        <field name="use_custom_repair_sender" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label
                            for="use_custom_repair_sender"
                            string="Use Custom Sender for Repairs"
                        />
                        <span
                            class="fa fa-lg fa-building-o"
                            title="Values set here are company-specific."
                            groups="base.group_multi_company"
                        />
                        <div class="text-muted">
                            Override the default 'From' address when sending repair quotations.
                        </div>
                        <div
                            class="row mt16"
                            attrs="{'invisible': [('use_custom_repair_sender', '=', False)]}"
                        >
                            <label
                                for="repair_custom_email_from"
                                string="Repair Custom Email Sender"
                                class="col-lg-4 o_light_label"
                            />
                            <field
                                name="repair_custom_email_from"
                                class="oe_inline"
                                attrs="{'required': [('use_custom_repair_sender', '=', True)]}"
                                placeholder="e.g. support@company.com"
                            />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
